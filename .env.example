# Database
DATABASE_URL="postgresql://user:password@localhost:5432/campus_food_pass?schema=public"

# JWT Configuration (CHANGE IN PRODUCTION - MIN 32 CHARS)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long-for-production"
QR_SECRET="your-super-secret-qr-hmac-key-minimum-64-characters-long-for-production"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Pool (for high concurrency)
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_LIMIT=20

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# QR Token Configuration
QR_TOKEN_TTL_MINUTES=30

# File Upload (if needed)
MAX_FILE_SIZE=5242880
UPLOAD_DIR="./public/uploads"

# Email (for notifications - optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@campusfoodpass.com"

# Payment Gateway (for future production use)
PAYMENT_GATEWAY_URL=""
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""